// AthleteConnect — Prisma schema
// Uses the new `prisma-client` generator: import from "@/generated/prisma".

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ATHLETE
  COACH
  PARENT
  AGENT
  ADMIN
}

enum UserStatus {
  PENDING // coaches await admin approval
  ACTIVE
  SUSPENDED
}

enum Plan {
  FREE // athlete free tier
  PREMIUM // athlete premium
  COACH_BASIC // coach $49
  COACH_PRO // coach $99
  ENTERPRISE // athletic dept / school
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  RESUME
  TRANSCRIPT
  CERTIFICATE
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         Role
  plan         Plan       @default(FREE)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  studentProfile StudentProfile?
  coachProfile   CoachProfile?
  parentProfile  ParentProfile?
  agentProfile   AgentProfile?
  subscriptions  Subscription[]

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  // coach-side collections
  watchlists Watchlist[]
  favorites  Favorite[]
  notes      CoachNote[]
  searchLogs SearchLog[]
  viewsMade  ProfileView[] @relation("Viewer")

  reportsMade Report[] @relation("Reporter")

  @@index([role])
  @@index([status])
}

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Personal
  firstName   String
  lastName    String
  photoUrl    String?
  galleryUrls String[] @default([]) // extra photos for the profile gallery
  location    String?
  state       String?
  height      Int? // inches
  weight      Int? // lbs

  // Academics
  gpa           Float?
  satScore      Int?
  actScore      Int?
  intendedMajor String?

  // Athletic
  sport          String
  position       String?
  bio            String?
  awards         String? // freeform, newline-separated
  achievements   String?
  graduationYear Int
  school         String

  verified Boolean @default(false)
  boosted  Boolean @default(false) // premium profile boosting

  videos       Video[]
  statistics   Statistic[]
  documents    Document[]
  favoritedBy  Favorite[]
  coachNotes   CoachNote[]
  watchItems   WatchlistItem[]
  profileViews ProfileView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sport])
  @@index([position])
  @@index([state])
  @@index([graduationYear])
  @@index([gpa])
}

model CoachProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName    String
  lastName     String
  school       String
  organization String?
  title        String?
  sport        String?
  location     String?
  bio          String?
  verified     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ParentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName    String
  lastName     String
  athleteName  String? // the athlete they follow
  relationship String? // e.g. Mother, Father, Guardian

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  agency    String?
  title     String?
  phone     String?
  verified  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Video {
  id         String           @id @default(cuid())
  studentId  String
  student    StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title      String
  url        String
  thumbnail  String?
  moderation ModerationStatus @default(APPROVED)
  createdAt  DateTime         @default(now())

  @@index([studentId])
}

model Statistic {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sport     String
  season    String?
  statName  String
  value     String
  createdAt DateTime       @default(now())

  @@index([studentId])
}

model Document {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      DocumentType
  title     String
  url       String
  createdAt DateTime       @default(now())

  @@index([studentId])
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan
  status    String    @default("active") // active | canceled
  startDate DateTime  @default(now())
  endDate   DateTime?

  @@index([userId])
}

model Watchlist {
  id        String          @id @default(cuid())
  coachId   String
  coach     User            @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime        @default(now())
  items     WatchlistItem[]

  @@index([coachId])
}

model WatchlistItem {
  id          String         @id @default(cuid())
  watchlistId String
  watchlist   Watchlist      @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  addedAt     DateTime       @default(now())

  @@unique([watchlistId, studentId])
}

model Favorite {
  id        String         @id @default(cuid())
  coachId   String
  coach     User           @relation(fields: [coachId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([coachId, studentId])
}

model CoachNote {
  id        String         @id @default(cuid())
  coachId   String
  coach     User           @relation(fields: [coachId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([coachId])
  @@index([studentId])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
}

model ProfileView {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  viewerId  String?
  viewer    User?          @relation("Viewer", fields: [viewerId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())

  @@index([studentId])
  @@index([createdAt])
}

model SearchLog {
  id        String   @id @default(cuid())
  coachId   String
  coach     User     @relation(fields: [coachId], references: [id], onDelete: Cascade)
  query     String // JSON blob of filters
  results   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String // VIDEO | PHOTO | DOCUMENT | PROFILE
  targetId   String
  reason     String
  status     String   @default("open") // open | resolved
  createdAt  DateTime @default(now())

  @@index([status])
}
